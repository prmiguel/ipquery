{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": ["ai/skills"]
  },
  "watcher": {
    "ignore": [
      "**/*.log",
      "tmp*/**",
      "node_modules/**",
      ".git/**",
      "dist/**"
    ]
  },
  "mcp": {
    "ipquery": {
      "type": "local",
      "command": ["node", "ai/mcp/ipquery-server/server.js"],
      "enabled": true
    }
  }
}
